# data-eng-bench environment variables. Copy to .env and fill in the values you need:
#   cp .env.example .env
#
# The DuckDB variant (DB_TYPE=duckdb, the default) is fully hermetic and needs
# only your agent's model API key. The Snowflake variant additionally needs the
# SNOWFLAKE_* values (or a ~/.snowflake/connections.toml connection).

# --- Agent model API key: set the one matching your --agent / --model ---
ANTHROPIC_API_KEY=            # claude-code
OPENAI_API_KEY=              # codex (and any OpenAI-compatible model or LLM judge)
# OPENAI_BASE_URL=           # optional: OpenAI-compatible proxy base URL

# --- Snowflake variant only (DB_TYPE=snowflake) ---
SNOWFLAKE_ACCOUNT=           # e.g. abcd-xy12345
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=          # or configure key-pair auth in ~/.snowflake/connections.toml
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=DBT_BENCH_RETAIL
SNOWFLAKE_ROLE=SYSADMIN
